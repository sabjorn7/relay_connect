-1c53-4857-855b-f2f6a40b7186-callPostgresFunction", "args": {"functionName": "club_prepare_subscription_order", "params": [{"key": "p_club_id", "value": {"__wwtype": "f", "code": "context.component?.variables?.[\'14d34912-0442-4607-9311-5c9590247a28\']?.club?.id"}}]}, "url": {"code": "const order = context.workflow[\'256f1eb9-180c-4d95-b3c2-f81bbfac9b0f\'].result;\\nif (!order?.id || !order?.subscription_id || !order?.club_id) throw new Error(\'Subscription order unavailable\');\\nconst baseUrl = \'https://meetguru.payform.ru/?do=link&sys=meetguru\';\\nconst urlSuccess = \'https://app.meetgu.ru/club?club=\' + encodeURIComponent(order.club_id);\\nreturn `${baseUrl}&subscription=${encodeURIComponent(order.subscription_id)}&order_id=${encodeURIComponent(order.id)}&urlSuccess=${encodeURIComponent(urlSuccess)}`;", "__wwtype": "js"}, "next": "417b8d6f-f0a7-4958-9521-f7f82105c689"}, {"object": "bb3f9590-8a49-40f8-9455-eeed3d72ac23", "type": "f9ef41c3-1c53-4857-855b-f2f6a40b7186-callPostgresFunction", "args": {"functionName": "club_prepare_subscription_order", "params": [{"key": "p_club_id", "value": {"__wwtype": "f", "code": "context.component?.variables?.[\'14d34912-0442-4607-9311-5c9590247a28\']?.club?.id"}}]}, "url": {"code": "const order = context.workflow[\'256f1eb9-180c-4d95-b3c2-f81bbfac9b0f\'].result;\\nif (!order?.id || !order?.subscription_id || !order?.club_id) throw new Error(\'Subscription order unavailable\');\\nconst baseUrl = \'https://meetguru.payform.ru/?do=link&sys=meetguru\';\\nconst urlSuccess = \'https://app.meetgu.ru/club?club=\' + encodeURIComponent(order.club_id);\\nreturn `${baseUrl}&subscription=${encodeURIComponent(order.subscription_id)}&order_id=${encodeURIComponent(order.id)}&urlSuccess=${encodeURIComponent(urlSuccess)}`;", "__wwtype": "js"}, "next": "417b8d6f-f0a7-4958-9521-f7f82105c689"}]')
+for op in ops:

+        hidden(value) { document.visibilityState = value ? 'hidden' : 'visible'; for (const fn of events.get('visibilitychange') || []) fn(); } };
+}
+function ready(f) {
+    assert.equal(f.context.__mgBootReady, true);
+    assert.equal(f.elements['mg-boot-loading'].hidden, true);
+    assert.equal(f.classes.has('mg-boot-pending'), false);
+    assert.equal(f.elements.app.getAttribute('aria-hidden'), null);
+    assert.equal(f.elements.app.getAttribute('inert'), null);

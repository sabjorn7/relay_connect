+
+const tag = '<link rel="stylesheet" crossorigin href="/assets/main-hash.css">';
+const transformed = nonBlockingBootCss(tag);
+assert.match(transformed, /rel="preload" as="style" data-mg-critical="pending"/);
+assert.match(transformed, /crossorigin href="\/assets\/main-hash.css"/);
+assert.match(transformed, /this.rel='stylesheet'/);
+assert.equal(nonBlockingBootCss(transformed), transformed);
+assert.equal(nonBlockingBootCss('<link rel="stylesheet" href="https://cdn.invalid/font.css">'), '<link rel="stylesheet" href="https://cdn.invalid/font.css">');
+assert.equal(nonBlockingBootCss('<!-- ' + tag + ' -->'), '<!-- ' + tag + ' -->');
+assert.equal(nonBlockingBootCss('<script>var x=' + JSON.stringify(tag) + '</script>'), '<script>var x=' + JSON.stringify(tag) + '</script>');
+assert.equal(nonBlockingBootCss('<link rel="preload" as="style" href="/fonts/font.css">'), '<link rel="preload" as="style" href="/fonts/font.css">');
+assert.ok(template.indexOf('id="mg-boot-loading"') < template.indexOf('<div id="app"'));
+assert.match(template, /#mg-boot-loading[^}]*font:16px\/1\.5 system-ui/);
+assert.match(template, /<noscript>\s*<style>#mg-boot-loading \{ display:none!important;/);
+
+class Element {
+    constructor(id) { this.id = id; this.attrs = {}; this.hidden = false; this.disabled = false; this.textContent = ''; this.childElementCount = 0; }
+    getAttribute(k) { return this.attrs[k] ?? null; }
+    setAttribute(k, v) { this.attrs[k] = v; }
+    removeAttribute(k) { delete this.attrs[k]; }
+    contains() { return false; }
+}
+function fixture(cssCount = 1) {
+    let t = 0, seq = 0, reloads = 0;
+    const timers = new Map(), events = new Map(), beacons = [];
+    const elements = Object.fromEntries(['app', 'mg-boot-loading', 'mg-boot-message', 'mg-boot-retry'].map(id => [id, new Element(id)]));
+    elements.app.attrs = { inert: '', 'aria-hidden': 'true', 'aria-busy': 'true' };
+    elements['mg-boot-retry'].hidden = true;
+    const classes = new Set(['mg-boot-pending']);
+    const links = Array.from({ length: cssCount }, (_, i) => {
+        const e = new Element('css' + i); e.attrs['data-mg-critical'] = 'pending';
+        e.href = 'https://example.invalid/assets/main-' + i + '.css'; e.rel = 'preload'; e.sheet = null; return e;
+    });
+    const document = {
+        visibilityState: 'visible', readyState: 'interactive',
+        documentElement: { classList: { remove: c => classes.delete(c) } },
+        getElementById: id => elements[id] || null,
+        querySelectorAll: () => links,
+        addEventListener: (type, fn) => { if (!events.has(type)) events.set(type, []); events.get(type).push(fn); },
+    };
+    function timer(fn, ms, interval = 0) { const id = ++seq; timers.set(id, { fn, at: t + ms, interval }); return id; }
+    const context = vm.createContext({
+        document, navigator: { onLine: true }, performance: { now: () => t, getEntriesByType: () => [] },
+        Date: { now: () => 1000000 + t }, Math, encodeURIComponent,
+        setTimeout: (fn, ms) => timer(fn, ms), clearTimeout: id => timers.delete(id),
+        setInterval: (fn, ms) => timer(fn, ms, ms), clearInterval: id => timers.delete(id),
+        requestAnimationFrame: fn => timer(fn, 16), location: { reload: () => reloads++ },
+        Image: class { set src(url) { const q = new URL(url, 'https://example.invalid').searchParams; beacons.push({ type: q.get('t'), message: q.get('m') }); } },
+    });
+    context.window = context;
+    vm.runInContext(boot, context);
+    function advance(ms) {
+        const end = t + ms;
+        while (true) {
+            let next;
+            for (const [id, task] of timers) if (task.at <= end && (!next || task.at < next[1].at)) next = [id, task];
+            if (!next) break;
+            const [id, task] = next; t = task.at;
+            if (task.interval) task.at += task.interval; else timers.delete(id);
+            task.fn();
+        }
+        t = end;
+    }
+    function css(index = 0, state = 'loaded', sheet = true) {
+        links[index].attrs['data-mg-critical'] = state;
+        links[index].rel = state === 'loaded' ? 'stylesheet' : 'preload';
+        links[index].sheet = state === 'loaded' && sheet ? {} : null;

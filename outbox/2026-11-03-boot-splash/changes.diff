+// Autonomous HTML bootstrap contract; no network, packages, browser or production access.
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import vm from 'node:vm';
+import { nonBlockingBootCss } from '../scripts/lib/boot-html.mjs';
+const template = fs.readFileSync(new URL('../template.html', import.meta.url), 'utf8');

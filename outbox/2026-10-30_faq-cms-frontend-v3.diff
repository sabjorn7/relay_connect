+const GUIDE_ORDER = ['course', 'stream', 'event', 'club', 'money'];
+
+function hashToGuide(hash) {
+    const k = (hash || '').replace('#', '');
+    return GUIDE_ORDER.includes(k) ? k : null;
+}
+
+const initialGuide = (typeof window !== 'undefined' && hashToGuide(window.location.hash)) || GUIDE_ORDER[0];
+const activeGuide = ref(initialGuide);
+const activeStep = reactive(Object.fromEntries(GUIDE_ORDER.map((g) => [g, 0])));
+const rootEl = ref(null);
+
+function setActive(g, i) {
+    activeStep[g] = i;
+}
+
+function selectGuide(g) {
+    activeGuide.value = g;
+    try {
+        history.replaceState(null, '', '#' + g);
+    } catch (e) { /* ignore — non-browser or sandboxed history */ }
+}
+
+function onHashChange() {
+    const g = hashToGuide(window.location.hash);
+    if (g) activeGuide.value = g;
+}
+
+function ensureFonts() {
+    if (document.getElementById('fg-fonts')) return;
+    const l = document.createElement('link');
+    l.id = 'fg-fonts';
+    l.rel = 'stylesheet';
+    l.href = 'https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700;800&display=swap';
+    document.head.appendChild(l);

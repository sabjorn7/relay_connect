+// snippets for the schematic "device screen" scenes. Content is entirely our own
+// static copy (never user input), same v-html trust posture as FaqPage.vue's old CONTENT.
+// -----------------------------------------------------------------------
+function P(t) {
+    return '<div class="fg-pg"><div class="fg-mb"><b>meetguru.</b><span>Мероприятия · Курсы · Клуб · Трансляции</span></div>' + (t ? '<h5 class="fg-pt">' + t + '</h5>' : '');
+}
+const E = '</div>';
+function f(l, p, h, big) {
+    return '<div class="fg-f' + (big ? ' big' : '') + (h ? ' hl' : '') + '"><i>' + l + '</i><u>' + p + '</u></div>';
+}
+function b(t, h, k) {
+    return '<span class="fg-mbt ' + (k || '') + (h ? ' hl' : '') + '">' + t + '</span>';
+}
+function sg(arr, i, h) {
+    return '<div class="fg-sg' + (h ? ' hl' : '') + '">' + arr.map((x, j) => '<span' + (j === i ? ' class="a"' : '') + '>' + x + '</span>').join('') + '</div>';
+}
+function ck(t, on, h) {
+    return '<div class="fg-ck' + (on ? ' on' : '') + (h ? ' hl' : '') + '"><s></s>' + t + '</div>';
+}
+function pr(h) {
+    return '<div class="fg-pr' + (h ? ' hl' : '') + '"><b></b></div>';
+}
+function mod(t, i, ft) {
+    return '<div class="fg-mod"><h5>' + t + '</h5>' + i + '<div class="fg-ft">' + (ft || '') + '</div></div>';
+}
+function cards(n) {
+    let s = '';
+    for (let i = 0; i < n; i++) s += '<div class="fg-cd">' + b('Черновик', 0, 'tagc') + '<i></i><i style="width:60%"></i></div>';
+    return '<div class="fg-cards">' + s + '</div>';
+}
+function note(t, h) {
+    return '<div class="fg-note' + (h ? ' hl' : '') + '">' + t + '</div>';
+}

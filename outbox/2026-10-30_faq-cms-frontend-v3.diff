+
+const observers = [];
+onMounted(async () => {
+    ensureFonts();
+    await nextTick();
+    // One IntersectionObserver per guide (mirrors guide2.html): on desktop widths, scrolling a
+    // step into the "active" viewport band highlights it and swaps the sticky stage scene.
+    // Steps of inactive guides sit at display:none (v-show) so they never intersect — same
+    // behaviour as the mockup's always-in-DOM `.guide{display:none}` sections.
+    GUIDE_ORDER.forEach((g) => {
+        const steps = rootEl.value?.querySelectorAll(`.fg-step[data-g="${g}"]`) || [];
+        if (!steps.length) return;
+        const io = new IntersectionObserver(
+            (entries) => {
+                entries.forEach((entry) => {
+                    if (entry.isIntersecting && window.innerWidth > 860) {
+                        setActive(g, Number(entry.target.dataset.i));
+                    }
+                });
+            },
+            { rootMargin: '-40% 0px -50% 0px' },
+        );
+        steps.forEach((s) => io.observe(s));
+        observers.push(io);
+    });

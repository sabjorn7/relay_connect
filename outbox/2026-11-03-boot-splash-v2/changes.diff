+// Observe the existing initial redirect; do not change route or authorization decisions.
+const pending = new Set();
+let navigationFailed = false;
+export function trackBootNavigation(promise) {
+    if (window.__mgBootReady) return promise;
+    const observed = Promise.resolve(promise).then(
+        failure => { if (failure && failure.type !== 16) navigationFailed = true; },
+        () => { navigationFailed = true; },
+    );
+    pending.add(observed);
+    observed.then(() => pending.delete(observed));
+    return promise;
+}
+
+export async function signalBootMounted({ nextTick, host = window, document = host.document }) {
+    const mountedAt = Math.round(host.performance.now());
+    await nextTick();
+    // setup()/mounted hooks may initiate a redirect; wait only for tracked navigation,
+    // never for the page's API requests, videos or fonts.
+    while (pending.size) { await Promise.all([...pending]); await nextTick(); }
+    host.__mgBootAppReady = () => {
+        const el = document.getElementById('app');
+        const marker = el?.querySelector('[data-mg-boot-shell]');
+        host.__mgBootInitError = !!host.__mgBootRootSetupError || navigationFailed || !marker;
+        // visibility is inherited from the splash gate, so test layout/display instead.
+        return !host.__mgBootInitError && [...el.children].some(child =>

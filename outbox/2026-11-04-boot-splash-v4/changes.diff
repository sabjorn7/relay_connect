--- /dev/null
+++ b/scripts/lib/boot-html.mjs
@@ -0,0 +1,18 @@
+// Applied after Vite has injected the entry CSS. Do not edit generated HTML or dist.
+export function nonBlockingBootCss(html) {
+    let count = 0;
+    const transformed = html.replace(/<script\b[^>]*>[\s\S]*?<\/script\s*>|<!--[\s\S]*?-->|<link\b[^>]*>/gi, (tag) => {
+        if (!/^<link\b/i.test(tag)) return tag;
+        if (/\bdata-mg-critical\b/i.test(tag)) { count++; return tag; }
+        const rel = /\brel\s*=\s*(["'])stylesheet\1/i;
+        const href = /\bhref\s*=\s*(["'])([^"']+)\1/i.exec(tag)?.[2];
+        if (!rel.test(tag) || !href || !/^\/assets\/[^?#]+\.css(?:[?#]|$)/i.test(href)) return tag;
+        count++;
+        return tag.replace(rel,
+            'rel="preload" as="style" data-mg-critical="pending" ' +
+            'onload="this.onload=null;this.rel=\'stylesheet\';this.setAttribute(\'data-mg-critical\',\'loaded\');if(window.__mgBootCheck)window.__mgBootCheck()" ' +
+            'onerror="this.setAttribute(\'data-mg-critical\',\'failed\');if(window.__mgBootCheck)window.__mgBootCheck()"');
+    });
+    // A missing production stylesheet must fail closed; only unbuilt dev HTML uses "dev".
+    return transformed.replace(/data-mg-boot-css="(?:dev|\d+)"/, 'data-mg-boot-css="' + count + '"');
+}

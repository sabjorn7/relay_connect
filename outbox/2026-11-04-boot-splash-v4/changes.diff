+// Compile real legacy rendering components. Only data/services/layout are mocked;
+// never import main.js, generated page registration modules, Auth or production APIs.
+import fs from 'node:fs';
+import path from 'node:path';
+import assert from 'node:assert/strict';
+import { createRequire } from 'node:module';
+const require = createRequire(import.meta.url);
+const { parse, compileTemplate, compileStyle } = require('@vue/compiler-sfc');
+
+export function legacyFixture(root) {
+    const modules = new Map();
+    let css = '';
+    function component(file, name, imports) {
+        const filename = path.join(root, file), { descriptor } = parse(fs.readFileSync(filename, 'utf8'));
+        const id = 'data-v-legacy-' + name;
+        const template = compileTemplate({ source: descriptor.template.content, filename, id,
+            scoped: descriptor.styles.some(style => style.scoped) });
+        assert.equal(template.errors.length, 0, file + ' template');
+        const rewrite = source => source.replace(/from\s+(['"])([^'"]+)\1/g, (_match, _quote, specifier) => {
+            const target = specifier === 'vue' ? '/vue.js' : imports[specifier];
+            assert.ok(target, 'Unmocked import: ' + specifier);
+            return 'from ' + JSON.stringify(target);
+        });
+        const script = rewrite(descriptor.script.content).replace('export default', 'const component =');
+        const render = rewrite(template.code).replace('export function render', 'function render');
+        modules.set('/legacy/' + name + '.js', script + '\n' + render +
+            '\ncomponent.render=render;component.__scopeId=' + JSON.stringify(id) + ';export default component;');
+        for (const style of descriptor.styles) {
+            const result = compileStyle({ source: style.content, filename, id, scoped: style.scoped, preprocessLang: style.lang });
+            assert.equal(result.errors.length, 0, file + ' CSS'); css += result.code;
+        }
+    }
+    const mocks = '/legacy/mocks.js';
+    component('src/_front/views/wwPage.vue', 'page', {
+        vuex: mocks, '@/_front/components/wwPageLoadProgress.vue': '/legacy/progress.js',
+        '@/_front/helpers/wwBackgroungStyle.js': mocks, '@/pinia/popup.js': mocks,

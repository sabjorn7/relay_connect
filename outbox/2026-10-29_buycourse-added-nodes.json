    {
      "parameters": {
        "jsCode": "// Проверка подписи Prodamus (HMAC-SHA256) по схеме их официального Hmac SDK.\n// Секрет ТОЛЬКО из $env.PRODAMUS_SECRET (не хардкод). Значения подписи/секрета/телефона/почты НЕ логировать.\n//\n// Hmac SDK (PHP): array_walk_recursive -> strval ВСЕХ листьев (true->'1', false->'', null->'');\n// затем рекурсивный ksort(SORT_REGULAR); затем json_encode($data, JSON_UNESCAPED_UNICODE) (НЕ query-string);\n// hash_hmac('sha256', json, key); сравнение strcasecmp (регистронезависимо). json_encode по умолчанию\n// экранирует '/' как '\\/' (JSON_UNESCAPED_SLASHES не выставлен) — повторяем. Подписывается ТОЛЬКО тело\n// (Sign приходит в заголовке, его в данные не кладём).\n// !! ОБЯЗАТЕЛЬНО сверить calc==Sign на реальном тест-уведомлении. Если не сходится — искать расхождение в:\n//    (1) форма products[] — PHP numeric-list -> JSON [..], а n8n multipart-парсер может дать объект {\"0\":..};\n//    (2) точный набор подписываемых полей; (3) экранирование '/'. Правка — здесь, до строгого режима.\nconst crypto = require('crypto');\nconst SECRET  = $env.PRODAMUS_SECRET || '';\nconst shop    = $('Shop').first().json || {};\nconst body    = shop.body || {};\nconst headers = shop.headers || {};\nconst sign    = String(headers['sign'] || headers['Sign'] || '').toLowerCase();\n\nfunction toStrDeep(v){\n  if (Array.isArray(v)) return v.map(toStrDeep);\n  if (v && typeof v === 'object'){ const o = {}; for (const k of Object.keys(v)) o[k] = toStrDeep(v[k]); return o; }\n  if (v === true)  return '1';\n  if (v === false) return '';\n  if (v === null || v === undefined) return '';\n  return String(v);\n}\nfunction ksortDeep(v){\n  if (Array.isArray(v)) return v.map(ksortDeep);\n  if (v && typeof v === 'object'){ const o = {}; for (const k of Object.keys(v).sort()) o[k] = ksortDeep(v[k]); return o; }\n  return v;\n}\nconst prepared = ksortDeep(toStrDeep(body));\nconst jsonStr  = JSON.stringify(prepared).replace(/\\//g, '\\\\/');\nconst calc     = SECRET ? crypto.createHmac('sha256', SECRET).update(jsonStr, 'utf8').digest('hex') : '';\nreturn [{ json: { sig_ok: !!calc && calc === sign, sign_present: !!sign } }];\n"
      },

    {
      "parameters": {
        "jsCode": "// Сериализация тела Prodamus под их Hmac SDK (без секрета и без обращения к окружению — только строит строку).\n// Prodamus Hmac (PHP): array_walk_recursive -> strval листьев; рекурсивный ksort; json_encode($data, JSON_UNESCAPED_UNICODE).\n// => кириллица/Unicode НЕ экранируются (literal UTF-8, как JS JSON.stringify), а '/' экранируется в '\\/'\n//    (JSON_UNESCAPED_SLASHES у Prodamus НЕ выставлен). Тело приходит form-urlencoded с ПЛОСКИМИ ключами\n//    products[0][name] -> разворачиваем во вложенную структуру (как PHP $_POST), числовые последовательные\n//    ключи -> массив (как PHP numeric-list -> json [..]). Подписывается только тело; Sign берём из заголовка.\n// !! ГЛАВНЫЙ РИСК: точная форма сериализации Prodamus. Проверяется на реальном платеже в WARN (valid=true).\nconst shop    = $('Shop').first().json || {};\nconst body    = shop.body || {};\nconst headers = shop.headers || {};\nconst sign    = String(headers['sign'] || headers['Sign'] || '').toLowerCase();\nfunction unflatten(flat){\n  const root = {};\n  for (const fk of Object.keys(flat)){\n    const parts = (String(fk).match(/[^\\[\\]]+/g)) || [fk];\n    let node = root;\n    for (let i = 0; i < parts.length; i++){\n      const k = parts[i];\n      if (i === parts.length - 1){ node[k] = flat[fk]; }\n      else { if (node[k] === undefined || node[k] === null || typeof node[k] !== 'object') node[k] = {}; node = node[k]; }\n    }\n  }\n  return root;\n}\nfunction arrayify(v){\n  if (Array.isArray(v)) return v.map(arrayify);\n  if (v && typeof v === 'object'){\n    const keys = Object.keys(v);\n    const seq = keys.length > 0 && keys.every((k, i) => k === String(i));\n    const out = seq ? [] : {};\n    for (const k of keys){ if (seq) out.push(arrayify(v[k])); else out[k] = arrayify(v[k]); }\n    return out;\n  }\n  return v;\n}\nfunction toStrDeep(v){\n  if (Array.isArray(v)) return v.map(toStrDeep);\n  if (v && typeof v === 'object'){ const o = {}; for (const k of Object.keys(v)) o[k] = toStrDeep(v[k]); return o; }\n  if (v === true)  return '1';\n  if (v === false) return '';\n  if (v === null || v === undefined) return '';\n  return String(v);\n}\nfunction ksortDeep(v){\n  if (Array.isArray(v)) return v.map(ksortDeep);\n  if (v && typeof v === 'object'){ const o = {}; for (const k of Object.keys(v).sort()) o[k] = ksortDeep(v[k]); return o; }\n  return v;\n}\nconst prepared   = ksortDeep(toStrDeep(arrayify(unflatten(body))));\nconst serialized = JSON.stringify(prepared).replace(/\\//g, '\\\\/');\nreturn [{ json: { serialized, sign } }];\n"
      },

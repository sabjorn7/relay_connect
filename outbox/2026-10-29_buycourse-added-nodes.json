    {
      "parameters": {
        "jsCode": "// Проверка подписи Prodamus (HMAC-SHA256) по схеме официального Hmac SDK.\n// Секрет ТОЛЬКО из $env.PRODAMUS_SECRET (не хардкод). Значения подписи/секрета/телефона/почты НЕ логировать.\n// secret_present в выводе показывает, доступен ли секрет (false = не задан ИЛИ $env заблокирован в Code-ноде).\n//\n// Hmac SDK (PHP): array_walk_recursive -> strval листьев (true->'1', false->'', null->''); рекурсивный ksort;\n// json_encode($data, JSON_UNESCAPED_UNICODE) (НЕ query-string); hash_hmac('sha256', json, key); сравнение\n// регистронезависимо. json_encode по умолчанию экранирует '/' как '\\/' — повторяем. Подписывается только тело.\n// !! Сверить calc==Sign на реальном тест-уведомлении (риск: форма products[] массив vs объект у n8n-парсера).\nconst crypto = require('crypto');\nconst SECRET  = (typeof $env !== 'undefined' && $env && $env.PRODAMUS_SECRET) ? $env.PRODAMUS_SECRET : '';\nconst shop    = $('Shop').first().json || {};\nconst body    = shop.body || {};\nconst headers = shop.headers || {};\nconst sign    = String(headers['sign'] || headers['Sign'] || '').toLowerCase();\n\nfunction toStrDeep(v){\n  if (Array.isArray(v)) return v.map(toStrDeep);\n  if (v && typeof v === 'object'){ const o = {}; for (const k of Object.keys(v)) o[k] = toStrDeep(v[k]); return o; }\n  if (v === true)  return '1';\n  if (v === false) return '';\n  if (v === null || v === undefined) return '';\n  return String(v);\n}\nfunction ksortDeep(v){\n  if (Array.isArray(v)) return v.map(ksortDeep);\n  if (v && typeof v === 'object'){ const o = {}; for (const k of Object.keys(v).sort()) o[k] = ksortDeep(v[k]); return o; }\n  return v;\n}\nconst prepared = ksortDeep(toStrDeep(body));\nconst jsonStr  = JSON.stringify(prepared).replace(/\\//g, '\\\\/');\nconst calc     = SECRET ? crypto.createHmac('sha256', SECRET).update(jsonStr, 'utf8').digest('hex') : '';\nreturn [{ json: { sig_ok: !!calc && calc === sign, sign_present: !!sign, secret_present: !!SECRET } }];\n"
      },

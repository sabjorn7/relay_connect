+						runIndex,
+						itemIndex,
+					},
+				);
+			}
+			const inputData =
+				that.runExecutionData?.resultData.runData[that.activeNodeName]?.[runIndex].inputOverride;
+			const placeholdersDataInputData =
+				inputData?.[NodeConnectionTypes.AiTool]?.[0]?.[itemIndex].json;

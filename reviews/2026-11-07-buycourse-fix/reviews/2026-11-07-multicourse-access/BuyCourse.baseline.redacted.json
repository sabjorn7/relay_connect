    {
      "parameters": {
        "jsCode": "// --- 1. Складываем ВСЕ amount из Create_Sales ---\nconst salesItems = $('Create_Sales').all();\n\nconst totalSalesAmount = salesItems.reduce((sum, item) => {\n  return sum + Number(item.json.amount || 0);\n}, 0);\n\n// --- 2. Берём UsersCreater.Ammount ---\nconst userCreator = $('UsersCreater').first()?.json || {};\nconst userCreatorAmount = Number(userCreator.Ammount || 0);\n\n// --- 3. Получаем user_id из UsersCreater ---\nconst userId = userCreator.id || userCreator.user_id || null;\n\n// --- 4. Получаем order.id из ноды Supabase5 (update) ---\nconst orderNode = $('Supabase').first()?.json || {};\nconst orderId = orderNode.id || orderNode.order_id || null;\n\n// --- 5. Итоговая сумма ---\nconst result = totalSalesAmount + userCreatorAmount;\n\n// --- 6. Возвращаем ОДИН item ---\nreturn [\n  {\n    result,\n    user_id: userId,\n    order_id: orderId\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
